{
  "name": "mpy-workbench",
  "icon": "media/logo.png",
  "displayName": "MPY Workbench",
  "description": "Browse and manage MicroPython files on ESP32 and similar boards via mpremote. Requires mpremote >= 1.26.",
  "version": "0.3.4",
  "publisher": "DanielBucam",
  "engines": {
    "vscode": "^1.84.0"
  },
  "extensionDependencies": [],
  "extensionPack": [],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, the Python interpreter and serial port are only read from user settings, never from the workspace's .vscode/settings.json.",
      "restrictedConfigurations": [
        "mpyWorkbench.pythonPath",
        "mpyWorkbench.connect",
        "mpyWorkbench.rootPath"
      ]
    }
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"dist/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.84.0",
    "typescript": "^5.4.0",
    "vsce": "^2.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielBustillos/mpy-workbench"
  },
  "contributes": {
    "viewsWelcome": [
      {
        "view": "mpyWorkbenchFsView",
        "contents": "No serial port selected.\n\n[Select Serial Port](command:mpyWorkbench.pickPort)",
        "when": "!mpyWorkbench.hasPort"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mpyWorkbenchFs",
          "title": "MPY Workbench",
          "icon": "./media/activitybar.svg"
        }
      ]
    },
    "customEditors": [],
    "css": [
      "./media/esp32fs.css"
    ],
    "views": {
      "mpyWorkbenchFs": [
        {
          "id": "mpyWorkbenchFsView",
          "name": "Files",
          "icon": "$(files)"
        },
        {
          "id": "mpyWorkbenchLocalFilesView",
          "name": "Local Files",
          "icon": "$(folder)"
        },
        {
          "id": "mpyWorkbenchActionsView",
          "name": "Board Actions",
          "icon": "$(tools)"
        },
        {
          "id": "mpyWorkbenchSyncView",
          "name": "Sync utilities",
          "icon": "$(sync)"
        }
      ]
    },
    "commands": [
      {
        "command": "mpyWorkbench.refresh",
        "title": "MPY Workbench: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "mpyWorkbench.initializeWorkspace",
        "title": "MPY Workbench: Initialize Workspace"
      },
      {
        "command": "mpyWorkbench.openFile",
        "title": "MPY Workbench: Open File from board"
      },
      {
        "command": "mpyWorkbench.uploadActiveFile",
        "title": "MPY Workbench: Upload Active File"
      },
      {
        "command": "mpyWorkbench.newFileBoardAndLocal",
        "title": "MPY Workbench: New File (Board + Local)",
        "icon": "$(new-file)"
      },
      {
        "command": "mpyWorkbench.newFileInTree",
        "title": "MPY Workbench: New File Here",
        "icon": "$(new-file)"
      },
      {
        "command": "mpyWorkbench.newFolderInTree",
        "title": "MPY Workbench: New Folder Here",
        "icon": "$(new-folder)"
      },
      {
        "command": "mpyWorkbench.renameNode",
        "title": "MPY Workbench: Rename File/Folder",
        "icon": "$(edit)"
      },
      {
        "command": "mpyWorkbench.pickPort",
        "title": "MPY Workbench: Select Serial Port",
        "icon": "$(plug)"
      },
      {
        "command": "mpyWorkbench.setPort",
        "title": "MPY Workbench: Use This Port"
      },
      {
        "command": "mpyWorkbench.mkdir",
        "title": "MPY Workbench: New Folder"
      },
      {
        "command": "mpyWorkbench.openSerial",
        "title": "MPY Workbench: Open Serial Monitor",
        "icon": "$(terminal)"
      },
      {
        "command": "mpyWorkbench.openRepl",
        "title": "MPY Workbench: Open REPL",
        "icon": "$(terminal)"
      },
      {
        "command": "mpyWorkbench.runActiveFile",
        "title": "MPY Workbench: Run file",
        "icon": "$(play)"
      },
      {
        "command": "mpyWorkbench.stop",
        "title": "MPY Workbench: Stop (Ctrl-C/A/D)",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mpyWorkbench.softReset",
        "title": "MPY Workbench: Soft Reset (Ctrl-D)",
        "icon": "$(debug-restart)"
      },
      {
        "command": "mpyWorkbench.syncBaseline",
        "title": "MPY Workbench: Sync all files (Local → Board)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mpyWorkbench.syncBaselineFromBoard",
        "title": "MPY Workbench: Sync all files (Board → Local)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mpyWorkbench.serialSendCtrlC",
        "title": "MPY Workbench: Interrupt (Ctrl-C, Ctrl-B)",
        "icon": "$(debug-pause)"
      },
      {
        "command": "mpyWorkbench.openFileFromLocal",
        "title": "MPY Workbench: Open File from Local (default)",
        "icon": "$(file-directory)"
      },
      {
        "command": "mpyWorkbench.syncFileLocalToBoard",
        "title": "MPY Workbench: Sync File Local → Board",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mpyWorkbench.syncFileBoardToLocal",
        "title": "MPY Workbench: Sync File Board → Local",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mpyWorkbench.delete",
        "title": "MPY Workbench: Delete from Board"
      },
      {
        "command": "mpyWorkbench.deleteBoardAndLocal",
        "title": "MPY Workbench: Delete from Board and Local",
        "icon": {
          "light": "./media/trash-red.svg",
          "dark": "./media/trash-red.svg"
        }
      },
      {
        "command": "mpyWorkbench.runFromView",
        "title": "MPY Workbench: Run Command (View Wrapper)"
      },
      {
        "command": "mpyWorkbench.syncBaselineFromView",
        "title": "MPY Workbench: Sync all files (Local → Board) (View)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mpyWorkbench.syncBaselineFromBoardFromView",
        "title": "MPY Workbench: Sync all files (Board → Local) (View)",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mpyWorkbench.runActiveFileFromView",
        "title": "MPY Workbench: Run file (View)",
        "icon": "$(play)"
      },
      {
        "command": "mpyWorkbench.openReplFromView",
        "title": "MPY Workbench: Open REPL (View)",
        "icon": "$(terminal)"
      },
      {
        "command": "mpyWorkbench.deleteAllBoard",
        "title": "MPY Workbench: Clear Device Files",
        "icon": {
          "light": "./media/trash-red.svg",
          "dark": "./media/trash-red.svg"
        }
      },
      {
        "command": "mpyWorkbench.deleteAllBoardFromView",
        "title": "MPY Workbench: Clear Device Files (View)",
        "icon": {
          "light": "./media/trash-red.svg",
          "dark": "./media/trash-red.svg"
        }
      },
      {
        "command": "mpyWorkbench.toggleWorkspaceAutoSync",
        "title": "MPY Workbench: Toggle workspace Auto-Sync on Save"
      },
      {
        "command": "mpyWorkbench.uploadToBoard",
        "title": "MPY Workbench: Upload to Board",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mpyWorkbench.localOpen",
        "title": "MPY Workbench: Open"
      },
      {
        "command": "mpyWorkbench.localCut",
        "title": "MPY Workbench: Cut"
      },
      {
        "command": "mpyWorkbench.localCopy",
        "title": "MPY Workbench: Copy"
      },
      {
        "command": "mpyWorkbench.localCopyPath",
        "title": "MPY Workbench: Copy Path"
      },
      {
        "command": "mpyWorkbench.localCopyRelativePath",
        "title": "MPY Workbench: Copy Relative Path"
      },
      {
        "command": "mpyWorkbench.localRename",
        "title": "MPY Workbench: Rename"
      },
      {
        "command": "mpyWorkbench.localDelete",
        "title": "MPY Workbench: Delete"
      },
      {
        "command": "mpyWorkbench.downloadFileFromBoard",
        "title": "MPY Workbench: Download File from Board",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mpyWorkbench.cancelAllTasks",
        "title": "MPY Workbench: Cancel All Tasks"
      },
      {
        "command": "mpyWorkbench.showLog",
        "title": "MPY Workbench: Show Log"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mpyWorkbench.syncBaselineFromView",
          "when": "view == mpyWorkbenchSyncView",
          "group": "navigation@0"
        },
        {
          "command": "mpyWorkbench.syncBaselineFromBoardFromView",
          "when": "view == mpyWorkbenchSyncView",
          "group": "navigation@1"
        },
        {
          "command": "mpyWorkbench.deleteAllBoardFromView",
          "when": "view == mpyWorkbenchSyncView",
          "group": "navigation@9"
        },
        {
          "command": "mpyWorkbench.runActiveFileFromView",
          "when": "view == mpyWorkbenchActionsView",
          "group": "navigation@0"
        },
        {
          "command": "mpyWorkbench.openReplFromView",
          "when": "view == mpyWorkbenchActionsView",
          "group": "navigation@1"
        },
        {
          "command": "mpyWorkbench.serialSendCtrlC",
          "when": "view == mpyWorkbenchActionsView",
          "group": "navigation@2"
        },
        {
          "command": "mpyWorkbench.refresh",
          "when": "view == mpyWorkbenchFsView",
          "group": "navigation@0"
        },
        {
          "command": "mpyWorkbench.pickPort",
          "when": "view == mpyWorkbenchFsView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "mpyWorkbench.renameNode",
          "when": "view == mpyWorkbenchFsView && (viewItem == file || viewItem == dir)",
          "group": "2_edit@1"
        },
        {
          "command": "mpyWorkbench.openFile",
          "when": "view == mpyWorkbenchFsView && viewItem == file",
          "group": "1_open@1"
        },
        {
          "command": "mpyWorkbench.openFileFromLocal",
          "when": "view == mpyWorkbenchFsView && viewItem == file",
          "group": "1_open@2"
        },
        {
          "command": "mpyWorkbench.syncFileLocalToBoard",
          "when": "view == mpyWorkbenchFsView && viewItem == file",
          "group": "2_sync@1"
        },
        {
          "command": "mpyWorkbench.syncFileBoardToLocal",
          "when": "view == mpyWorkbenchFsView && viewItem == file",
          "group": "2_sync@2"
        },
        {
          "command": "mpyWorkbench.newFileInTree",
          "when": "view == mpyWorkbenchFsView && (viewItem == dir || viewItem == file)",
          "group": "0_create@0"
        },
        {
          "command": "mpyWorkbench.newFolderInTree",
          "when": "view == mpyWorkbenchFsView && (viewItem == dir || viewItem == file)",
          "group": "0_create@1"
        },
        {
          "command": "mpyWorkbench.delete",
          "when": "view == mpyWorkbenchFsView && (viewItem == file || viewItem == dir)",
          "group": "3_delete@1"
        },
        {
          "command": "mpyWorkbench.deleteBoardAndLocal",
          "when": "view == mpyWorkbenchFsView && (viewItem == file || viewItem == dir)",
          "group": "3_delete@2"
        },
        {
          "command": "mpyWorkbench.newFileBoardAndLocal",
          "when": "view == mpyWorkbenchFsView && !viewItem",
          "group": "0_create@0"
        },
        {
          "command": "mpyWorkbench.newFileInTree",
          "when": "view == mpyWorkbenchFsView && !viewItem",
          "group": "0_create@1"
        },
        {
          "command": "mpyWorkbench.newFolderInTree",
          "when": "view == mpyWorkbenchFsView && !viewItem",
          "group": "0_create@2"
        },
        {
          "command": "mpyWorkbench.uploadToBoard",
          "when": "view == mpyWorkbenchLocalFilesView && (viewItem == file || viewItem == dir)",
          "group": "inline"
        },
        {
          "command": "mpyWorkbench.uploadToBoard",
          "when": "view == mpyWorkbenchLocalFilesView && (viewItem == file || viewItem == dir)",
          "group": "0_board@0"
        },
        {
          "command": "mpyWorkbench.localOpen",
          "when": "view == mpyWorkbenchLocalFilesView && (viewItem == file || viewItem == dir)",
          "group": "1_open@0"
        },
        {
          "command": "mpyWorkbench.localCut",
          "when": "view == mpyWorkbenchLocalFilesView && (viewItem == file || viewItem == dir)",
          "group": "2_clipboard@0"
        },
        {
          "command": "mpyWorkbench.localCopy",
          "when": "view == mpyWorkbenchLocalFilesView && (viewItem == file || viewItem == dir)",
          "group": "2_clipboard@1"
        },
        {
          "command": "mpyWorkbench.localCopyPath",
          "when": "view == mpyWorkbenchLocalFilesView && (viewItem == file || viewItem == dir)",
          "group": "3_path@0"
        },
        {
          "command": "mpyWorkbench.localCopyRelativePath",
          "when": "view == mpyWorkbenchLocalFilesView && (viewItem == file || viewItem == dir)",
          "group": "3_path@1"
        },
        {
          "command": "mpyWorkbench.localRename",
          "when": "view == mpyWorkbenchLocalFilesView && (viewItem == file || viewItem == dir)",
          "group": "4_edit@0"
        },
        {
          "command": "mpyWorkbench.localDelete",
          "when": "view == mpyWorkbenchLocalFilesView && (viewItem == file || viewItem == dir)",
          "group": "4_edit@1"
        },
        {
          "command": "mpyWorkbench.downloadFileFromBoard",
          "when": "view == mpyWorkbenchFsView && viewItem == file",
          "group": "2_sync@3"
        }
      ],
      "commandPalette": [
        {
          "command": "mpyWorkbench.openFile",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.newFileInTree",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.newFolderInTree",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.renameNode",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.openFileFromLocal",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.syncFileLocalToBoard",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.syncFileBoardToLocal",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.delete",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.deleteBoardAndLocal",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.downloadFileFromBoard",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.uploadToBoard",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.localOpen",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.localCut",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.localCopy",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.localCopyPath",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.localCopyRelativePath",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.localRename",
          "when": "false"
        },
        {
          "command": "mpyWorkbench.localDelete",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "MPY Workbench",
      "properties": {
        "mpyWorkbench.autoSyncOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Auto-sync on save: when enabled, saving a local file also uploads it to the board; when disabled, only saves locally. Per-workspace override available in .mpy-workbench/config.json."
        },
        "mpyWorkbench.connect": {
          "type": "string",
          "default": "auto",
          "description": "Serial device (e.g. auto, /dev/ttyUSB0, COM3)",
          "scope": "machine-overridable"
        },
        "mpyWorkbench.serialAutoSuspend": {
          "type": "boolean",
          "default": true,
          "description": "Automatically close the REPL terminal before file ops and reopen after."
        },
        "mpyWorkbench.interruptOnConnect": {
          "type": "boolean",
          "default": true,
          "description": "On opening the REPL, send Ctrl-C to interrupt any running program."
        },
        "mpyWorkbench.strictConnect": {
          "type": "boolean",
          "default": true,
          "description": "Before opening REPL, perform a strict handshake (reset + quick check + retry) to ensure prompt like Thonny."
        },
        "mpyWorkbench.preListDelayMs": {
          "type": "number",
          "default": 150,
          "description": "Delay (ms) before listing after interrupt/reset to allow OS/device to settle."
        },
        "mpyWorkbench.rootPath": {
          "type": "string",
          "default": "/",
          "description": "Root path to show on device (e.g. /, /lib)"
        },
        "mpyWorkbench.usePyRawList": {
          "type": "boolean",
          "default": false,
          "description": "List directories using a Python raw REPL script (requires python3 + mpremote)."
        },
        "mpyWorkbench.baudRate": {
          "type": "number",
          "default": 115200,
          "description": "Serial baud rate for UART bridges (ignored on native USB CDC). Try 921600 or 1500000 if your board/adapter supports it."
        },
        "mpyWorkbench.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Override Python interpreter path. Leave empty to use VS Code's configured Python interpreter.",
          "scope": "machine-overridable"
        },
        "mpyWorkbench.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Write detailed debug messages to the 'MPY Workbench' output channel."
        },
        "mpyWorkbench.thonnyShortcuts": {
          "type": "boolean",
          "default": true,
          "description": "Thonny-style shortcuts while a serial port is selected: F5 runs the active Python file on the board, Ctrl+F2 (Cmd+F2 on macOS) stops it. Disable to keep F5 for the VS Code debugger."
        },
        "mpyWorkbench.localRoot": {
          "type": "string",
          "default": "",
          "description": "Local folder (relative to the workspace) that mirrors the board's root path, e.g. \"device\". Leave empty to sync the whole workspace. .mpyignore patterns are relative to this folder."
        },
        "mpyWorkbench.autoStopBeforeBoardAction": {
          "type": "boolean",
          "default": false,
          "description": "Automatically stop a program started with \"Run file\" (Ctrl-C) before uploads, auto-sync on save, Run file, Stop and Soft reset, so the serial port is free. When disabled, stop the program yourself first (Thonny-style)."
        }
      }
    },
    "keybindings": [
      {
        "command": "mpyWorkbench.runActiveFile",
        "key": "f5",
        "when": "editorLangId == python && mpyWorkbench.hasPort && config.mpyWorkbench.thonnyShortcuts && !inDebugMode"
      },
      {
        "command": "mpyWorkbench.stop",
        "key": "ctrl+f2",
        "mac": "cmd+f2",
        "when": "mpyWorkbench.hasPort && config.mpyWorkbench.thonnyShortcuts && !inDebugMode"
      }
    ]
  }
}
